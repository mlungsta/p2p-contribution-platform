APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
NODE_ENV="development"

# Pooled runtime connection for app/API traffic.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/p2p_contribution_platform?schema=public"

# Direct connection for Prisma migrations (Neon direct URL in staging/production).
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/p2p_contribution_platform?schema=public"

SESSION_SECRET="replace-with-strong-random-secret-min-16"
TEST_SESSION_SECRET="replace-with-strong-random-secret-min-16"
ENABLE_E2E_SESSION_BOOTSTRAP="false"
ENABLE_TEST_AUTH_HELPER="false"
PLAYWRIGHT_TEST="0"

# Used by postdeploy health check script.
HEALTHCHECK_URL="http://localhost:3000"

# Optional Upstash Redis rate limit provider.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional external log sink.
LOG_PROVIDER_URL=""
LOG_PROVIDER_TOKEN=""

# Optional error monitoring sink.
ERROR_MONITORING_URL=""
ERROR_MONITORING_TOKEN=""
