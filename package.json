    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit",
                    "test":  "npm run test:compile \u0026\u0026 node scripts/run-tests.mjs",
                    "test:compile":  "tsc -p tsconfig.test.json",
                    "test:auth":  "npm run test:compile \u0026\u0026 node scripts/auth-boundary-tests.mjs",
                    "test:schema":  "node scripts/schema-db-tests.mjs",
                    "test:runtime":  "npm run test:compile \u0026\u0026 node scripts/runtime-integration-tests.mjs",
                    "test:ui-runtime":  "npm run test:compile \u0026\u0026 node scripts/ui-runtime-route-tests.mjs",
                    "test:e2e":  "playwright test",
                    "test:stress":  "npm run test:compile \u0026\u0026 node scripts/matching-concurrency-stress.mjs",
                    "predeploy:enum":  "node scripts/predeploy-enum-contraction.mjs",
                    "ops:alerts":  "node scripts/ops-alert-check.mjs",
                    "test:watch":  "npm test",
                    "test:security":  "npm run test:compile \u0026\u0026 node scripts/security-ops-tests.mjs",
                    "test:deploy-config":  "npm run test:compile \u0026\u0026 node scripts/deployment-config-tests.mjs",
                    "predeploy:checks":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run build \u0026\u0026 npm test \u0026\u0026 npm run test:auth \u0026\u0026 npm run test:schema \u0026\u0026 npm run test:runtime \u0026\u0026 npm run test:ui-runtime \u0026\u0026 npm run test:e2e \u0026\u0026 npm run test:stress \u0026\u0026 npm run test:security \u0026\u0026 npm run test:deploy-config \u0026\u0026 npm run predeploy:enum \u0026\u0026 npm run migrate:status",
                    "migrate:status":  "prisma migrate status",
                    "deploy:staging:migrate":  "prisma migrate deploy --schema prisma/schema.prisma",
                    "deploy:production:migrate":  "prisma migrate deploy --schema prisma/schema.prisma",
                    "postdeploy:health":  "node scripts/postdeploy-health-check.mjs",
                    "verify:staging-env":  "node scripts/verify-staging-env.mjs"
                },
